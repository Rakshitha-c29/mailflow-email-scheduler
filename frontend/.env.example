# MailFlow scheduler — frontend (Vite dev server). Copy to frontend/.env if you need
# to change these; the defaults work with the backend's defaults.

# Where the Vite dev server proxies /api and /admin (the backend's PORT).
# API_URL=http://localhost:4000

# Dev server port. If you change it, set the backend's FRONTEND_URL to match.
# PORT=5173
