# MailFlow scheduler — backend configuration.
# Copy to backend/.env and fill in the REQUIRED values. Everything else has a sensible
# default (shown commented out). The server validates this file on start and prints
# exactly which variable is wrong if something is off.

# ── Required ────────────────────────────────────────────────────────────────────
# Matches docker-compose.yml.
DATABASE_URL=postgres://mailflow:mailflow@localhost:5432/mailflow

# Signs session cookies (JWT). At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters-from-the-command-above

# AES-256-GCM key for secrets at rest (Ethereal SMTP passwords, Slack tokens): exactly
# 64 hex characters. Generate with the same command. NEVER change it once data exists:
# stored sender passwords can't be decrypted with a different key.
ENCRYPTION_KEY=replace-with-64-hex-characters-0000000000000000000000000000000000

# Google OAuth (https://console.cloud.google.com/apis/credentials → OAuth client, type
# "Web application"). Add GOOGLE_REDIRECT_URI as an authorized redirect URI.
# The app runs with placeholders; only "Login with Google" won't work.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Server ──────────────────────────────────────────────────────────────────────
# NODE_ENV=development        # production: JSON logs, no pretty printing
# PORT=4000
# LOG_LEVEL=info              # fatal | error | warn | info | debug | trace
# FRONTEND_URL=http://localhost:5173   # CORS origin + OAuth redirect target
# COOKIE_SECURE=false         # true behind HTTPS
# ADMIN_EMAILS=               # comma-separated; who may open /admin/queues, read-only (empty = any signed-in user)

# ── Infrastructure (docker-compose defaults) ────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=emails

# ── Slack (optional: set all three or none) ─────────────────────────────────────
# Rate-limit notifications. Slack requires an HTTPS redirect URL: a tunnel locally (see README → Slack setup),
# your own HTTPS domain in a real deployment.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=https://your-tunnel.example.com/api/integrations/slack/callback

# ── Worker ──────────────────────────────────────────────────────────────────────
# WORKER_CONCURRENCY=5        # emails processed in parallel per worker process
# EMAIL_JOB_ATTEMPTS=3        # SMTP attempts for network/transient errors (not throttling)
# EMAIL_JOB_BACKOFF_MS=5000   # exponential backoff base between those attempts

# ── Rate limits: system-wide CEILINGS (a campaign can be stricter, never looser) ─
# MIN_DELAY_BETWEEN_EMAILS_MS=2000     # minimum gap between two sends of one sender
# MAX_EMAILS_PER_HOUR_PER_SENDER=200
# GLOBAL_MAX_EMAILS_PER_SECOND=20      # across all senders and workers
# RATE_WINDOW_MS=3600000               # the "hour"; set 60000 for demos (limits per minute)

# ── Provider throttling (temporary 4xx SMTP replies) ────────────────────────────
# THROTTLE_COOLDOWN_BASE_S=60          # first cooldown of the sender
# THROTTLE_COOLDOWN_MAX_S=900          # doubling stops here (15 min)
# THROTTLE_MAX_DEFERRALS=10            # then the email fails with a clear reason

# ── Campaigns ───────────────────────────────────────────────────────────────────
# MAX_RECIPIENTS_PER_CAMPAIGN=10000
# SENDERS_PER_USER=2                   # Ethereal mailboxes per user (2..10); missing ones are added at next sign-in
# ATTACHMENT_MAX_FILES=5
# ATTACHMENT_MAX_TOTAL_BYTES=10485760  # 10 MB, all files together

# ── Password sign-in brute-force limits (per window) ────────────────────────────
# AUTH_ATTEMPT_WINDOW_S=900
# LOGIN_MAX_PER_IP=20
# LOGIN_MAX_FAILURES_PER_EMAIL=5       # failed attempts only; a success resets it
# SIGNUP_MAX_PER_IP=10
# SIGNUP_MAX_PER_EMAIL=3
