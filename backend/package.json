{
  "name": "mailflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MailFlow email scheduler: API + BullMQ workers",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --import ./test/helpers/testEnv.mts --test-global-setup=./test/helpers/globalSetup.mts --test --test-force-exit --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:throttling": "node --import tsx --import ./test/helpers/testEnv.mts --test-global-setup=./test/helpers/globalSetup.mts --test --test-force-exit test/throttling.test.ts",
    "test:ethereal": "node --import tsx --import ./test/helpers/testEnv.mts --test-global-setup=./test/helpers/globalSetup.mts --test --test-force-exit \"test/e2e/**/*.e2e.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "reindex": "tsx scripts/reindex.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "load-test": "tsx scripts/load-test.ts",
    "slack:preview": "tsx scripts/slack-preview.ts",
    "cleanup:test-leftovers": "tsx scripts/cleanup-test-leftovers.ts",
    "remove-email-jobs": "tsx scripts/remove-email-jobs.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@elastic/elasticsearch": "^8.19.2",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.28",
    "pino-pretty": "^13.1.3",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
